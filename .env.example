# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# Discord bot token (required only for live mode: `python -m discord_ai_bot --live`).
# Create a bot at https://discord.com/developers/applications and copy its token.
DISCORD_TOKEN=your-discord-bot-token-here

# Optional: only respond in guild channels when the bot is mentioned (true/false).
DISCORD_REQUIRE_MENTION=false

# Conversation memory: max stored turns per channel.
MAX_HISTORY=20

# Rate limiting (token bucket per user).
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SEC=1.0

# If you wire in a real LLM provider, put its key here (not used by FakeLLM).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
